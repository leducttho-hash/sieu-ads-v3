{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sieuads-oauth-pilot",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/auth/*"]},
  "d1_databases": [{"binding":"AUTH_DB","database_name":"sieuads-oauth-pilot-auth","database_id":"REPLACE_WITH_NEW_PILOT_DATABASE_ID"}],
  "vars": {"APP_ORIGIN":"https://REPLACE_WITH_PILOT_HOST","SESSION_DAYS":"14"},
  "observability": {"enabled":false}
}
