{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sieuads-oauth-pilot",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":true},
  "d1_databases": [{"binding":"AUTH_DB","database_name":"sieuads-oauth-pilot-auth","database_id":"82063811-4af9-45c4-a0e7-c697c9de3ba2"}],
  "vars": {"APP_ORIGIN":"https://sieuads-oauth-pilot.leducttho.workers.dev","SESSION_DAYS":"14"},
  "observability": {"enabled":false}
}
